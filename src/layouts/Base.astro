---
import { ClientRouter } from 'astro:transitions';
import LikeDefs from '../components/LikeDefs.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { SITE } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const { title, description = SITE.description, ogImage } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Тема ставится до первой отрисовки, иначе тёмная страница на миг мелькнёт светлой.
         ClientRouter при переходе меняет атрибуты <html> на новые, поэтому тему возвращаем после каждой подмены. -->
    <script is:inline>
      (() => {
        const media = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => { try { return localStorage.getItem('blog.theme'); } catch { return null; } };
        const pick = () => { const s = saved(); return s === 'dark' || s === 'light' ? s : media.matches ? 'dark' : 'light'; };
        const reading = () => { try { return localStorage.getItem('blog.reading') === '1'; } catch { return false; } };
        const apply = () => {
          const root = document.documentElement;
          root.dataset.theme = pick();
          // режим чтения тоже ставим до отрисовки, чтобы страница не прыгала
          if (reading()) root.dataset.reading = ''; else delete root.dataset.reading;
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
        // пока пользователь сам не выбрал тему, следуем за системой
        media.addEventListener('change', () => { if (!saved()) apply(); });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,500&display=swap"
    />
    <!-- Плавные переходы между страницами: аватар и заголовок «перетекают» -->
    <ClientRouter />
  </head>
  <body>
    <LikeDefs />
    <div class="corner-tools">
      <button type="button" class="search-open" id="search-open" aria-label="Поиск по блогу" aria-keyshortcuts="Control+K Meta+K">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <kbd class="search-kbd">Ctrl K</kbd>
      </button>
      <ThemeToggle />
    </div>
    <slot />
    <SearchPalette />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/client';
    </script>
  </body>
</html>
