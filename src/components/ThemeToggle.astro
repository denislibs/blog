---
// Кнопка темы «Солнце в луну». Логика переключения в src/scripts/theme.ts.
// Лучи втягиваются и поворачиваются, диск растёт, и на него наезжает «откус» маски: получается месяц.
---
<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Переключить тему">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <mask id="theme-moon-bite">
        <rect x="-6" y="-6" width="36" height="36" fill="#fff"></rect>
        <circle class="bite" cx="16.5" cy="7.5" r="6.2" fill="#000"></circle>
      </mask>
    </defs>
    <g mask="url(#theme-moon-bite)"><circle class="disk" cx="12" cy="12" r="4.6" fill="currentColor"></circle></g>
    <g class="rays" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 1.8v2.3M12 19.9v2.3M1.8 12h2.3M19.9 12h2.3M4.8 4.8l1.6 1.6M17.6 17.6l1.6 1.6M4.8 19.2l1.6-1.6M17.6 6.4l1.6-1.6"></path>
    </g>
  </svg>
</button>
