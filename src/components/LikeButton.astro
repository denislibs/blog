---
// Счётчик подгружается с /api/likes, анимация «Фонтан» живёт в src/scripts/like-fx.ts.
// Градиенты для сердец лежат в LikeDefs.astro (подключён в Base.astro).
import { HEART_PATH } from '../lib/heart';

interface Props {
  slug: string;
  title: string;
  size?: 'md' | 'lg';
}
const { slug, title, size = 'md' } = Astro.props;
---
<button
  type="button"
  class:list={['like', { lg: size === 'lg' }]}
  data-like={slug}
  aria-pressed="false"
  aria-label={`Нравится: ${title}`}
>
  <span class="like-icon" aria-hidden="true">
    <svg class="like-fx" viewBox="-24 -24 72 72"></svg>
    <svg class="like-heart" viewBox="0 0 24 24">
      <path class="like-outline" d={HEART_PATH}></path>
      <path class="like-fill" d={HEART_PATH}></path>
    </svg>
  </span>
  <span class="n"></span>
</button>
