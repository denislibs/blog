---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/PostMeta.astro';
import LikeButton from '../../components/LikeButton.astro';
import { SITE } from '../../site.config';
import { getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[(i + 1) % posts.length] },
  }));
}

interface Props {
  post: Post;
  next: Post;
}
const { post, next } = Astro.props;
const { Content } = await render(post);
const { author } = SITE;
---
<Base title={post.data.title} description={post.data.excerpt}>
  <div class="B-read">
    <header class="B-bar">
      <a class="B-me" href="/">
        <img class="avatar" src={author.avatar} alt="" width="40" height="40" transition:name="me" />
        <span><b>{author.name} {author.surname}</b><small>{author.role}</small></span>
      </a>
      <a class="B-back" href="/">← Все записи</a>
    </header>
    <article>
      <h1 class="B-h1" transition:name={`t-${post.id}`}>{post.data.title}</h1>
      <PostMeta post={post} withAuthor />
      <div class="md"><Content /></div>
      <div class="B-end">
        <LikeButton slug={post.id} title={post.data.title} size="lg" />
        {next.id !== post.id && (
          <a class="next" href={`/posts/${next.id}/`}>
            <small>Следующая запись</small>
            <span>{next.data.title} →</span>
          </a>
        )}
      </div>
    </article>
  </div>
</Base>
